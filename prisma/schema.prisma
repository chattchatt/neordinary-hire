generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phone             String
  birthDate         DateTime?

  affiliation       String
  organization      String?
  roles             String[]

  techStack         String
  certifications    String?
  experience        String?
  projectExperience String?  @db.Text

  communityType     String?
  generation        Int?
  communityRole     String?
  track             String?

  availability      String
  workType          String
  workRegion        String
  employmentTypes   String[]

  portfolioUrl      String?
  bio               String?  @db.Text
  notes             String?  @db.Text

  isQuickRegister   Boolean  @default(false)

  // Discord community trust integration
  hireLinkCode      String?  @unique
  discordUserId     String?  @unique
  discordUsername   String?
  discordDisplayName String?
  discordNickname   String?
  discordRoles      String[] @default([])
  discordJoinedAt   DateTime?
  lastDiscordActiveAt DateTime?
  discordActivitySummary String? @db.Text
  discordLinkedAt   DateTime?
  activityConsentAt DateTime?

  availabilityUpdatedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bookmarks         Bookmark[]
  activities        MemberActivity[]
}

model MemberActivity {
  id        String   @id @default(cuid())
  memberId  String
  source    String
  type      String
  summary   String   @db.Text
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())

  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, occurredAt])
}

model Company {
  id           String   @id @default(cuid())
  name         String
  industry     String?
  region       String?
  contactName  String?
  contactEmail String?
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  bookmarks    Bookmark[]
}

model Bookmark {
  id        String   @id @default(cuid())
  companyId String
  memberId  String
  memo      String?  @db.Text
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])

  @@unique([companyId, memberId])
}